    "motion": "^13.2.0",
    "next": "16.3.4",
    "node-fetch": "^3.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unfurl.js": "^6.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/env": "16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
